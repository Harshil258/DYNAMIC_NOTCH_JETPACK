<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher background.

  An iOS 17 style wallpaper wash, matching the gradient behind the Dynamic
  Island in `design/reference/ios17-dynamic-island/iPhone 15 Pro.svg`.
  Replaces the stock Android green grid background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="6"
                android:endX="88"
                android:endY="102">
                <item android:color="#FFB3122A" android:offset="0.0" />
                <item android:color="#FFFF3B30" android:offset="0.22" />
                <item android:color="#FFFF9F0A" android:offset="0.44" />
                <item android:color="#FFFF2D92" android:offset="0.68" />
                <item android:color="#FF32ADE6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft top-left light, the way iOS wallpapers fall off -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="20"
                android:gradientRadius="86">
                <item android:color="#3DFFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
