<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher foreground — the app mark.

  A Dynamic Island capsule drawn at the reference proportions taken from
  `design/reference/ios17-dynamic-island/Compact Presentation.svg`
  (126 x 36.67, corner radius 18.335 = 50% of the height) together with the
  TrueDepth camera lens, scaled to sit inside the 66dp adaptive safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ambient shadow under the capsule -->
    <path
        android:pathData="M34.64 48.46H73.36A8.44,8.44 0 0 1 81.8,56.9A8.44,8.44 0 0 1 73.36,65.34H34.64A8.44,8.44 0 0 1 26.2,56.9A8.44,8.44 0 0 1 34.64,48.46Z"
        android:fillColor="#2E000000" />

    <!-- island body -->
    <path
        android:pathData="M33.44 45.56H74.56A8.44,8.44 0 0 1 83,54A8.44,8.44 0 0 1 74.56,62.44H33.44A8.44,8.44 0 0 1 25,54A8.44,8.44 0 0 1 33.44,45.56Z"
        android:fillColor="#FF000000" />

    <!-- 12% specular hairline, as measured on the reference capsules -->
    <path
        android:pathData="M33.44 45.56H74.56A8.44,8.44 0 0 1 83,54A8.44,8.44 0 0 1 74.56,62.44H33.44A8.44,8.44 0 0 1 25,54A8.44,8.44 0 0 1 33.44,45.56Z"
        android:strokeColor="#1FFFFFFF"
        android:strokeWidth="0.8" />

    <!-- TrueDepth lens -->
    <path
        android:pathData="M74.21,54A2.65,2.65 0 1 0 79.5,54A2.65,2.65 0 1 0 74.21,54Z"
        android:fillColor="#FF121216" />
    <path android:pathData="M75.16,54A1.69,1.69 0 1 0 78.55,54A1.69,1.69 0 1 0 75.16,54Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="76.3"
                android:centerY="53"
                android:gradientRadius="2.3">
                <item android:color="#FF2E6FA8" android:offset="0.0" />
                <item android:color="#FF0B1622" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M75.59,52.95A0.71,0.71 0 1 0 77.02,52.95A0.71,0.71 0 1 0 75.59,52.95Z"
        android:fillColor="#B3EAF4FF" />

    <!-- Face ID emitter on the opposite side of the capsule -->
    <path
        android:pathData="M29.28,54A1.32,1.32 0 1 0 31.92,54A1.32,1.32 0 1 0 29.28,54Z"
        android:fillColor="#FF141418" />
</vector>
